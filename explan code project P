metrics = [
    ("Total tasks", len(all_tasks)),
    ("Active", active_count),
    ("Completed", completed_count),
    ("High priority", high_priority_count),
]
# zip จับคู่ "คอลัมน์" กับ "(ชื่อ, ตัวเลข)" ไปพร้อมกันทีละคู่
