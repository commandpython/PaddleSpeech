def add_task(tasks, title, category, priority, due_date, due_time, reminder, notes):
    """สร้างงานใหม่แล้วเพิ่มเข้า list tasks"""
    due_at = ""
    if due_date:
        # รวม "วัน" กับ "เวลา" เป็นก้อนเดียว
        # ถ้าไม่ได้เลือกเวลา ใช้ 17:00 เป็นค่าตั้งต้น
        # .isoformat() แปลงเป็นข้อความ เช่น "2026-10-10T17:00:00" (เก็บลง JSON ได้)
        due_at = datetime.combine(due_date, due_time or time(17, 0)).isoformat()

    tasks.append(
        {
            "id": str(uuid4()),                          # ID ไม่ซ้ำ ใช้อ้างอิงงานตอนลบ/แก้
            "title": title.strip(),
            "category": category,
            "priority": priority,
            "due_at": due_at,                            # "" ถ้าไม่มี deadline
            "reminder_minutes": REMINDER_OPTIONS[reminder],   # แปลงข้อความ -> นาที
            "notes": notes.strip(),
            "completed": False,                          # งานใหม่ยังไม่เสร็จ
        }
    )


def task_matches(task, search_text, category, status):
    """เช็คว่างานนี้ผ่านตัวกรองหรือไม่ (คืน True/False) ต้องผ่านครบทั้ง 3 เงื่อนไข"""
    # รวมชื่อ + โน้ต เป็นตัวพิมพ์เล็กเพื่อค้นหาแบบไม่สนตัวใหญ่เล็ก
    searchable_text = f"{task['title']} {task.get('notes', '')}".lower()

    matches_search = search_text.lower() in searchable_text          # 1) ตรงคำค้นหา
    matches_category = category == "All" or task["category"] == category   # 2) ตรงหมวด
    matches_status = (                                               # 3) ตรงสถานะ
        status == "All"
        or (status == "Active" and not task["completed"])
        or (status == "Completed" and task["completed"])
    )
    return matches_search and matches_category and matches_status


def sort_tasks(tasks):
    """เรียงงาน: ยังไม่เสร็จก่อน -> deadline ใกล้สุดก่อน -> ความสำคัญสูงก่อน"""
    priority_order = {"High": 0, "Medium": 1, "Low": 2}   # เลขน้อย = มาก่อน
    return sorted(
        tasks,
        key=lambda task: (
            task["completed"],   # False(0) มาก่อน True(1) -> งานค้างอยู่บน
            # งานที่ไม่มี deadline ใช้วันปลอม 9999 เพื่อให้ไปอยู่ท้าย
            task.get("due_at", task.get("due_date", "")) or "9999-12-31T23:59:59",
            priority_order.get(task["priority"], 3),
        ),
    )


def format_due_date(value):
    """แปลง deadline เป็นข้อความอ่านง่าย เช่น 'Due 10 Oct 2026 at 17:00'"""
    if not value:
        return "No deadline"
    try:
        if "T" in value:
            # รูปแบบใหม่: มีทั้งวันและเวลา
            due = datetime.fromisoformat(value)
            return f"Due {due.strftime('%d %b %Y at %H:%M')}"
        # รูปแบบเก่า: มีแค่วัน
        due = date.fromisoformat(value)
        return f"Due {due.strftime('%d %b %Y')}"
    except ValueError:
        return "Invalid deadline"


def get_task_due(task):
    """ดึงค่า deadline: ใช้ due_at (ใหม่) ถ้าไม่มีลอง due_date (ข้อมูลเก่า) เพื่อให้เข้ากันได้"""
    return task.get("due_at") or task.get("due_date", "")


def format_reminder(task):
    """แปลงนาทีเป็นข้อความ เช่น 15 -> 'Reminder 15 min before'"""
    reminder = int(task.get("reminder_minutes", 0))
    if reminder == 0:
        return "No reminder"
    if reminder < 60:
        return f"Reminder {reminder} min before"
    if reminder % 1440 == 0:                       # หารด้วย 1440 ลงตัว = เป็นหน่วยวัน
        return f"Reminder {reminder // 1440} day before"
    return f"Reminder {reminder // 60} hr before"  # ที่เหลือเป็นหน่วยชั่วโมง


def ics_escape(value):
    """ใส่ \\ นำหน้าอักขระพิเศษ (\\ ; , และขึ้นบรรทัดใหม่) เพราะไฟล์ .ics ตีความอักขระเหล่านี้พิเศษ"""
    return str(value).replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,").replace("\n", "\\n")


def create_calendar_event(task):
    """สร้างข้อความไฟล์ปฏิทิน .ics (เปิดได้ใน Google Calendar / Apple Calendar)"""
    due_value = get_task_due(task)
    due = datetime.fromisoformat(due_value)
    # กิจกรรมยาว 30 นาที นับจากเวลา deadline
    end = due.replace(second=0, microsecond=0) + timedelta(minutes=30)
    start_text = due.strftime("%Y%m%dT%H%M%S")    # รูปแบบเวลาของไฟล์ .ics
    end_text = end.strftime("%Y%m%dT%H%M%S")

    reminder = int(task.get("reminder_minutes", 0))
    alarm = ""
    if reminder:
        # VALARM = ตัวแจ้งเตือน, TRIGGER:-PT15M แปลว่า "ก่อนเริ่ม 15 นาที"
        alarm = (
            "BEGIN:VALARM\n"
            f"TRIGGER:-PT{reminder}M\n"
            "ACTION:DISPLAY\n"
            f"DESCRIPTION:{ics_escape(task['title'])}\n"
            "END:VALARM\n"
        )

    # ประกอบเป็นข้อความไฟล์ .ics ตามมาตรฐาน iCalendar
    return (
        "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Focus Board//EN\n"
        "BEGIN:VEVENT\n"
        f"UID:{task['id']}@focus-board\n"
        f"DTSTART:{start_text}\nDTEND:{end_text}\n"
        f"SUMMARY:{ics_escape(task['title'])}\n"
        f"DESCRIPTION:{ics_escape(task.get('notes', ''))}\n"
        f"CATEGORIES:{ics_escape(task.get('category', ''))}\n"
        f"{alarm}END:VEVENT\nEND:VCALENDAR\n"
    )


