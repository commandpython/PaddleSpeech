# สัดส่วนความคืบหน้า 0-1 (ถ้าไม่มีงานเลยให้เป็น 0 กันหารด้วยศูนย์)
progress = completed_count / len(all_tasks) if all_tasks else 0

# ---- 6.4 โชว์กล่องสถิติ 4 ช่อง ----
