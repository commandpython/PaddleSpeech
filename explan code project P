# ---------------------------------------------------------------------

# เปลี่ยนตัวอักษรที่ไม่ใช่ a-z A-Z 0-9 _ - ให้เป็น "_" เพื่อใช้เป็นชื่อไฟล์ได้ปลอดภัย
# และตัดให้ยาวไม่เกิน 40 ตัว
# (ข้อสังเกต: ชื่อภาษาไทยจะกลายเป็น "_" ทั้งหมด ทำให้คนชื่อไทยต่างกันอาจชนไฟล์เดียวกัน)
profile_key = re.sub(r"[^a-zA-Z0-9_-]", "_", st.session_state.profile_name)[:40]

# ตำแหน่งไฟล์ เช่น user_data/Alice.json
DATA_FILE = Path("user_data") / f"{profile_key}.json"
DATA_FILE.parent.mkdir(exist_ok=True)   # สร้างโฟลเดอร์ user_data ถ้ายังไม่มี


def load_tasks():
    """อ่านงานจากไฟล์ JSON ถ้าไม่มีไฟล์หรือไฟล์พัง ให้คืน list ว่าง"""
    try:
        if DATA_FILE.exists():
            with DATA_FILE.open("r", encoding="utf-8") as file:
                data = json.load(file)
            # ป้องกันกรณีไฟล์ไม่ใช่ list: ถ้าไม่ใช่ list คืน [] แทน
            return data if isinstance(data, list) else []
    except (json.JSONDecodeError, OSError):
        # JSON พัง หรือเปิดไฟล์ไม่ได้
        st.warning("ไม่สามารถอ่านไฟล์ข้อมูลเดิมได้ จึงเริ่มรายการใหม่")
    return []


def save_tasks(tasks):
    """บันทึกรายการงานทั้งหมดลงไฟล์ JSON (เรียกทุกครั้งที่ข้อมูลเปลี่ยน)"""
    try:
        with DATA_FILE.open("w", encoding="utf-8") as file:
            # ensure_ascii=False -> เก็บภาษาไทยเป็นตัวอักษรจริง ไม่ใช่ \u0e01
            # indent=2 -> จัดย่อหน้าให้คนเปิดไฟล์อ่านง่าย
            json.dump(tasks, file, ensure_ascii=False, indent=2)
    except OSError as error:
        st.error(f"บันทึกข้อมูลไม่สำเร็จ: {error}")


